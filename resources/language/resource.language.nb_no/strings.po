### SETTINGS
msgctxt "#30500"
msgid "Interface"
msgstr "Grensesnitt"

msgctxt "#30501"
msgid "Features"
msgstr "Funksjoner"

msgctxt "#30503"
msgid "Set the display mode for the notifications"
msgstr "Visningsmodus for varslene"

msgctxt "#30505"
msgid "Show a \"Stop\" button instead of a \"Close\" button"
msgstr "Vis en «Stopp»-knapp i stedet for en «Lukk»-knapp"

msgctxt "#30507"
msgid "Use OK/Select for playback controls"
msgstr "Bruk OK/Velg for avspillingskontroller"

msgctxt "#30508"
msgid "Use arrows to seek; hold OK for Up Next buttons"
msgstr "Bruk piltastene til å spole; hold OK for Up Next-knappene"

msgctxt "#30600"
msgid "Behaviour"
msgstr "Oppførsel"

msgctxt "#30601"
msgid "Features"
msgstr "Funksjoner"

msgctxt "#30603"
msgid "Default action when nothing selected"
msgstr "Standardhandling når ingenting er valgt"

msgctxt "#30605"
msgid "Include already watched episodes"
msgstr "Ta med episoder som allerede er sett"

msgctxt "#30607"
msgid "Number of episodes before \"Still there?\" query"
msgstr "Antall episoder før «Er du der fortsatt?»"

msgctxt "#30609"
msgid "Duration in seconds for notification to be shown"
msgstr "Hvor mange sekunder varselet vises"

msgctxt "#30611"
msgid "Customize autoplay duration by episode length"
msgstr "Tilpass varigheten etter episodelengde"

msgctxt "#30613"
msgid "All episodes  [COLOR gray]any length[/COLOR]"
msgstr "Alle episoder  [COLOR gray]uansett lengde[/COLOR]"

msgctxt "#30615"
msgid "Very short episodes  [COLOR gray]< 10 mins[/COLOR]"
msgstr "Svært korte episoder  [COLOR gray]< 10 min[/COLOR]"

msgctxt "#30617"
msgid "Short episodes  [COLOR gray]> 10 mins[/COLOR]"
msgstr "Korte episoder  [COLOR gray]> 10 min[/COLOR]"

msgctxt "#30619"
msgid "Medium episodes  [COLOR gray]> 20 mins[/COLOR]"
msgstr "Middels lange episoder  [COLOR gray]> 20 min[/COLOR]"

msgctxt "#30621"
msgid "Long episodes  [COLOR gray]> 40 mins[/COLOR]"
msgstr "Lange episoder  [COLOR gray]> 40 min[/COLOR]"

msgctxt "#30623"
msgid "Very long episodes  [COLOR gray]> 60 mins[/COLOR]"
msgstr "Svært lange episoder  [COLOR gray]> 60 min[/COLOR]"

msgctxt "#30625"
msgid "Advance during credits after (seconds, 0 disables)"
msgstr "Gå videre under rulleteksten etter (sekunder, 0 slår av)"

msgctxt "#30627"
msgid "Intros and recaps"
msgstr "Intro og sammendrag"

msgctxt "#30629"
msgid "Show a Skip button when the add-on marks them"
msgstr "Vis en «Hopp over»-knapp når tillegget markerer dem"

msgctxt "#30631"
msgid "Skip intros automatically"
msgstr "Hopp over intro automatisk"

msgctxt "#30633"
msgid "Skip recaps automatically"
msgstr "Hopp over sammendrag automatisk"

msgctxt "#30635"
msgid "Ask if still watching after (minutes, 0 disables)"
msgstr "Spør om du fortsatt ser på etter (minutter, 0 slår av)"

msgctxt "#30637"
msgid "Ask if still watching after bedtime"
msgstr "Spør om du fortsatt ser på etter leggetid"

msgctxt "#30639"
msgid "Bedtime hour"
msgstr "Leggetid, time"

msgctxt "#30641"
msgid "Bedtime minute"
msgstr "Leggetid, minutt"

msgctxt "#30643"
msgid "Mark an episode as watched when moving to the next one early"
msgstr "Marker en episode som sett når du går videre før den er ferdig"

msgctxt "#30645"
msgid "Continue a partly watched next episode where it was left"
msgstr "Fortsett en delvis sett neste episode der du slapp"

msgctxt "#30647"
msgid "Pause the video while an add-on starts the next episode"
msgstr "Pause videoen mens et tillegg starter neste episode"

msgctxt "#30661"
msgid "Stop playback after this many seconds without an answer"
msgstr "Stopp avspillingen etter så mange sekunder uten svar"

msgctxt "#30663"
msgid "Countdown in seconds before the next episode starts  [COLOR gray]0 = until the episode ends[/COLOR]"
msgstr "Nedtelling i sekunder før neste episode starter  [COLOR gray]0 = til episoden slutter[/COLOR]"

msgctxt "#30665"
msgid "Chapter markers"
msgstr "Kapittelmarkører"

msgctxt "#30667"
msgid "Use chapter markers to detect the credits  [COLOR gray]first choice, over the credits file and the times above[/COLOR]"
msgstr "Bruk kapittelmarkører til å finne rulleteksten  [COLOR gray]førstevalg, foran rulletekstfilen og tidene over[/COLOR]"

msgctxt "#30669"
msgid "Chapter names that mean the credits  [COLOR gray]comma separated[/COLOR]"
msgstr "Kapittelnavn som betyr rulletekst  [COLOR gray]kommaseparert[/COLOR]"

msgctxt "#30679"
msgid "Wait this many seconds after the chapter starts  [COLOR gray]chapters often start before the credits[/COLOR]"
msgstr "Vent så mange sekunder etter at kapittelet starter  [COLOR gray]kapitler starter ofte før rulleteksten[/COLOR]"

msgctxt "#30671"
msgid "Continue with the next season when a season ends"
msgstr "Fortsett med neste sesong når en sesong er ferdig"

msgctxt "#30675"
msgid "Credits file next to the video"
msgstr "Rulletekstfil ved siden av videoen"

msgctxt "#30677"
msgid "Use <video name>.skipcredits.json when it exists  [COLOR gray]when the video has no credits chapter, over the times above[/COLOR]"
msgstr "Bruk <videonavn>.skipcredits.json når den finnes  [COLOR gray]når videoen ikke har et rulletekstkapittel, foran tidene over[/COLOR]"

msgctxt "#30673"
msgid "Full-screen \"Are you still watching?\"  [COLOR gray]pauses playback and stops it when nobody answers[/COLOR]"
msgstr "Fullskjerm «Ser du fortsatt på?»  [COLOR gray]pauser avspillingen og stopper den hvis ingen svarer[/COLOR]"

